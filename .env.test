# Test settings for tools/e2e.sh. This file is loaded on top of `.env`, so
# runtime defaults still come from `.env` and only test-specific overrides live
# here. Keep this file aligned with `.env` when related settings change.
#
# Another overlay file: JSON_RPC_ENV_OVERLAY=path.

# TCP tuning inherits from .env unless a test explicitly overrides it here.
# Reliable UDP settings also inherit from .env unless a test needs different
# retransmit or deduplication parameters.

# tools/e2e.sh
JSON_RPC_E2E_BIND=127.0.0.1,::1
JSON_RPC_E2E_HOST=127.0.0.1,::1
JSON_RPC_E2E_HTTP1_HOST=127.0.0.1
JSON_RPC_E2E_PORT_BASE=41400
