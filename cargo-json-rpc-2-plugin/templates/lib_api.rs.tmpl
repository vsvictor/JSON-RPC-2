//! `__NAME__` plugin for JSON-RPC-2 servers (generated by cargo json-rpc-2-plugin).
//!
//! Плагін `__NAME__` для серверів JSON-RPC-2 (згенеровано cargo json-rpc-2-plugin).
//!
//! Contract (params / results) lives in [`api`], application logic in [`logic`];
//! this file only wires them into the server.
//! Контракт (параметри / результати) — у [`api`], прикладна логіка — у [`logic`];
//! цей файл лише підключає їх до сервера.

pub mod api;
pub mod logic;

use std::{sync::Arc, time::Duration};

use anyhow::Result;
use json_rpc_2_server::{FromSettings, PluginHandle, RpcServer, ServerPlugin};

use api::Api;
pub use logic::__PASCAL__Service;

/// Settings `__PREFIX__*`; blank values count as unset.
#[derive(FromSettings)]
#[settings(prefix = "__PREFIX__")]
pub struct __PASCAL__Config {
    /// `__PREFIX__GREETING`, default `Hello`.
    #[setting(default = "Hello")]
    pub greeting: String,
    /// `__PREFIX__RESET_SECS`, default 3600.
    #[setting(secs, default = 3600)]
    pub reset_secs: Duration,
}

impl ServerPlugin for __PASCAL__Config {
    const NAME: &'static str = "__NAME__";

    async fn install(self, server: &RpcServer) -> Result<PluginHandle> {
        let service = Arc::new(__PASCAL__Service::new(self.greeting));
        service.clone().register_rpc(server)?;
        Ok(PluginHandle::new().with_maintenance(
            self.reset_secs,
            service,
            |service| async move {
                tracing::info!("__NAME__: reset {} call(s)", service.reset());
                Ok(())
            },
        ))
    }
}

