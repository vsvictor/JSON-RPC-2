# Settings of the JSON-RPC 2.0 server and client:
# `cargo run -p json-rpc-2-cli --bin JSON_RPC_2 -- server`,
# `cargo run -p json-rpc-2-cli --bin JSON_RPC_2 -- client` and tools/*.sh.
# Another file: JSON_RPC_ENV=path.
# Command-line options and environment variables take precedence over this file.
# An empty value means "not set".

# Transports: all, or a comma-separated list of
# tcp,tls,udp,dccp,sctp,quic,http1,http3,ws-tcp,ws-udp,ws-dccp,ws-sctp,ws-quic,ws-http1,ws-http3
# DCCP and SCTP transports currently require Linux or Android kernel support.
JSON_RPC_TRANSPORT=all

# --- Server -------------------------------------------------------------------
# Local addresses the server listens on (required), comma-separated:
#   127.0.0.1,::1   this machine only (IPv4 and IPv6 loopback)
#   0.0.0.0,::      every network interface: reachable from the LAN
#   192.168.0.10    one interface only
JSON_RPC_BIND=0.0.0.0,::

# TLS for TLS/TCP, QUIC, HTTP/3 and WebSocket/HTTP/3: certificate chain and private key,
# PEM; relative paths are relative to the project root (certs/ there).
# If both files are missing, a self-signed pair for localhost, 127.0.0.1 and
# ::1 is generated; for the LAN generate one with tools/gen-cert.sh.
JSON_RPC_CERT=certs/cert.pem
JSON_RPC_KEY=certs/key.pem

# Server-side transport/runtime limits
JSON_RPC_SERVER_MAX_CONNECTIONS=4096
JSON_RPC_SERVER_MAX_CONCURRENT_REQUESTS=1024
# TCP-based transport tuning
JSON_RPC_TCP_NODELAY=true
# system|bbr; BBR depends on kernel support and is typically a Linux-only choice
JSON_RPC_TCP_CONGESTION=bbr
# TCP Fast Open is optional and OS-specific; client-side support is currently
# available only on Linux/Android, while listener-side support also covers macOS/iOS.
JSON_RPC_TCP_FASTOPEN=true
JSON_RPC_TCP_FASTOPEN_QUEUE_LEN=1024
# Reliable UDP tuning; one JSON-RPC message must fit into a single datagram.
JSON_RPC_UDP_RETRANSMIT_MS=50
JSON_RPC_UDP_MAX_RETRANSMITS=5
JSON_RPC_UDP_MAX_PACKET_SIZE=4096
JSON_RPC_UDP_DEDUP_CACHE_CAPACITY=4096
JSON_RPC_UDP_DEDUP_CACHE_TTL_MS=30000

# --- Client -------------------------------------------------------------------
# Server the client calls (optional; default in the example code:
# mobilespace.local), comma-separated IP addresses or host names.
JSON_RPC_HOST=mobilespace.local

# Certificates to trust for TLS transports (default: JSON_RPC_CERT), e.g. a root CA
JSON_RPC_CA=
# TLS name to verify (default: the host called)
JSON_RPC_SERVER_NAME=

# Client-side transport recovery: after this many consecutive missed pong ticks
# the client first tries restore(), then reconnect().
JSON_RPC_MAX_MISSED_PONGS=3
JSON_RPC_REQUEST_TIMEOUT_MS=30000
# Optional reconnect backoff policy: initial cooldown, max exponential backoff,
# additive jitter and max elapsed reconnect budget, all in milliseconds.
JSON_RPC_RECONNECT_COOLDOWN_MS=
JSON_RPC_RECONNECT_MAX_BACKOFF_MS=
JSON_RPC_RECONNECT_JITTER_MS=
JSON_RPC_RECONNECT_MAX_ELAPSED_MS=

# --- Script variants ----------------------------------------------------------
# tools/server.sh ipv4|ipv6|lan
JSON_RPC_BIND_IPV4=127.0.0.1
JSON_RPC_BIND_IPV6=::1
JSON_RPC_BIND_LAN=0.0.0.0,::

# tools/client.sh ipv4|ipv6
JSON_RPC_HOST_IPV4=127.0.0.1
JSON_RPC_HOST_IPV6=::1

# Test-only overrides live in .env.test, loaded on top of this file by
# tools/e2e.sh. Keep .env.test in sync when changing related defaults here,
# including TCP tuning defaults when tests need transport-specific overrides.

# --- Ports (server and client), required for every used transport ------------
# Transports of the same protocol cannot share a port.
# TCP
JSON_RPC_TCP_PORT=8000
# TLS-encrypted TCP
JSON_RPC_TLS_PORT=8445
# UDP + app-level reliability
JSON_RPC_UDP_PORT=8100
# RTP/RTCP over UDP
JSON_RPC_RTP_PORT=8106
# Reliable UDP with explicit sequencing
JSON_RPC_RUDP_PORT=8107
# Encrypted reliable UDP-style transport
JSON_RPC_SRT_PORT=8108
# CoAP-style constrained application transport
JSON_RPC_COAP_PORT=8109
# DCCP (Linux/Android only)
JSON_RPC_DCCP_PORT=8102
# SCTP (Linux/Android only)
JSON_RPC_SCTP_PORT=8104
# UDP-Lite (Linux/Android only)
JSON_RPC_UDPLITE_PORT=8114
# UDP
JSON_RPC_QUIC_PORT=8200
# TCP
JSON_RPC_HTTP1_PORT=8081
# UDP
JSON_RPC_HTTP3_PORT=8443
# TCP
JSON_RPC_WS_TCP_PORT=8002
# UDP + WebSocket-style framing
JSON_RPC_WS_UDP_PORT=8101
# RTP/RTCP + WebSocket-style framing
JSON_RPC_WS_RTP_PORT=8110
# Reliable UDP + WebSocket-style framing
JSON_RPC_WS_RUDP_PORT=8111
# SRT + WebSocket-style framing
JSON_RPC_WS_SRT_PORT=8112
# CoAP + WebSocket-style framing
JSON_RPC_WS_COAP_PORT=8113
# DCCP + WebSocket-style framing (Linux/Android only)
JSON_RPC_WS_DCCP_PORT=8103
# SCTP + WebSocket-style framing (Linux/Android only)
JSON_RPC_WS_SCTP_PORT=8105
# UDP-Lite + WebSocket-style framing (Linux/Android only)
JSON_RPC_WS_UDPLITE_PORT=8115
# UDP
JSON_RPC_WS_QUIC_PORT=8444
# TCP
JSON_RPC_WS_HTTP1_PORT=8001
# UDP
JSON_RPC_WS_HTTP3_PORT=8043
